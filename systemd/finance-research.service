[Unit]
Description=finance: weekly strategy research session (claude -p)
After=network-online.target
Wants=network-online.target
OnFailure=finance-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/personal/bot-vs-market
EnvironmentFile=%h/.secrets/finance.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_STATE_HOME=%h/.local/state
ExecStart=%h/personal/bot-vs-market/bin/run-research.sh
TimeoutStartSec=3h
Nice=5
