[Unit]
Description=finance: weekly strategy research session (claude -p)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/personal/finance
EnvironmentFile=%h/.secrets/finance.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_STATE_HOME=%h/.local/state
ExecStart=%h/personal/finance/bin/run-research.sh
TimeoutStartSec=3h
Nice=5
