---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Term from "../components/Term.astro";
import LineChart from "../components/LineChart.astro";
import YearBars from "../components/YearBars.astro";
import { site, url } from "../lib/site";

const bts = [...site.strategy.backtests].reverse();
const S = site.strategy;
const PR = S.params || {};
const tr = PR.trend || {}, mo = PR.momentum || {}, se = PR.selection || {}, si = PR.sizing || {};
const u = S.universe || {};
const pc = (v: number) => `${Math.round(v * 100)}%`;
const blob = (f: string) => `${site.repo_url}/blob/main/${f}`;
const buyable = (u.etf || 0) + (u.stock || 0) + (u.etc || 0) + (u.crypto || 0);
const decisions = [
  { title: "What it can buy", fact: `${buyable} instruments`, term: "etf-etc-etp",
    text: `A fixed list: ${u.etf || 0} ETFs, ${u.stock || 0} large-cap stocks, ${u.etc || 0} gold ETCs and ${u.crypto || 0} bitcoin ETP, all priced in EUR. The ${u.cash || 0} cash-like ETFs on the list are never bought.` },
  { title: "When it invests", fact: "Only in an uptrend", term: "trend-filter",
    text: `New buys only while the MSCI World is above its ${tr.sma_days}-day average. Everything is sold if it closes ${pc(tr.exit_band)} below it.` },
  { title: "What it picks", fact: `The top ${se.top_n} by momentum`, term: "momentum-12-1",
    text: `Everything is ranked by its ${Math.round(mo.lookback_days / 21)}-month return, skipping the latest month. It buys the best ${se.top_n} with positive momentum.` },
  { title: "When it sells", fact: "Once a month", term: "rebalance-window",
    text: `In the first ${se.rebalance_window_days} trading days of each month, a holding is sold if it drops out of the top ${se.hold_rank} or its momentum turns negative.` },
  { title: "How much in each", fact: `${pc(si.target_weight)} per position`, term: "position-weight",
    text: `Equal weights. One order is at most ${pc(si.order_cap_pct_of_nav)} of the portfolio and at least €${si.min_order_eur}, so fees stay small.` },
  { title: "How fast it trades", fact: `${si.max_orders_per_day} orders a day`, term: "guardrails",
    text: "Sells go first. A full rotation takes a few days, on purpose: slow and cheap beats fast and noisy." },
];
const P = (v: any) => (v == null ? "—" : `${(v * 100).toFixed(1)}%`);
const N = (v: any, d = 2) => (v == null ? "—" : Number(v).toLocaleString("en-IE", { minimumFractionDigits: d, maximumFractionDigits: d }));
const rows: [string, string | null, (v: any) => string][] = [
  ["cagr", "CAGR", P], ["max_drawdown", "Max drawdown", P], ["sharpe", "Sharpe ratio", (v) => N(v)],
  ["volatility", "Volatility", P], ["trades", "Trades", (v) => (v == null ? "—" : String(v))], ["fees_eur", "Fees (EUR)", (v) => N(v)],
  ["turnover_per_year", "Turnover / year", (v) => (v == null ? "—" : `${N(v)}×`)], ["end_nav", "End NAV (EUR)", (v) => N(v)],
];
// Trade counts, fees and turnover are only computed for the full period.
const OOS_NA = new Set(["trades", "fees_eur", "turnover_per_year"]);
const termFor: Record<string, string> = { cagr: "cagr", max_drawdown: "drawdown", sharpe: "sharpe-ratio", volatility: "volatility", turnover_per_year: "turnover", end_nav: "nav" };
---
<Base title="Strategy" current="strategy/">
  <PageHead eyebrow={`Current version · ${site.version}`} title="Strategy">
    The rules the agent follows, written as code and versioned. A change needs a written argument and a <Term id="backtest">backtest</Term>, and it shows up in the changelog below.
  </PageHead>

  <div class="wrap">
    <section class="block intro">
      <p class="eyebrow">In one paragraph</p>
      <h2>How {site.version} works</h2>
      <p class="summary">{S.summary}</p>
      <div class="files">
        <a href={blob("strategy/current.py")}>Algorithm</a>
        <a href={blob("strategy/params.toml")}>Parameters</a>
        <a href={blob("strategy/universe.csv")}>Universe</a>
        <a href={blob(`research/backtests/${site.version}.json`)}>Backtest data</a>
      </div>
    </section>

    <section class="block">
      <div class="block-head"><h2>Key decisions</h2><p>Numbers come straight from the live parameters</p></div>
      <ol class="decisions">
        {decisions.map((d, i) => (
          <li class="card decision">
            <span class="n num">{String(i + 1).padStart(2, "0")}</span>
            <p class="t">{d.title}</p>
            <p class="f">{d.fact}</p>
            <p class="x">{d.text} <Term id={d.term}>More</Term></p>
          </li>
        ))}
      </ol>
    </section>

    {bts.map((b: any) => (
      <section class="block bt">
        <div class="block-head">
          <h2>Backtest {b.version}</h2>
          <p class="num">{b.period.start} → {b.period.end}</p>
        </div>
        <div class="grid stats">
          <div class="card kpi"><span class="k"><Term id="cagr">CAGR</Term></span><span class="v num">{P(b.strategy.cagr)}</span><span class="c">benchmark {P(b.benchmark.cagr)}</span></div>
          <div class="card kpi"><span class="k"><Term id="drawdown">Max drawdown</Term></span><span class="v num">{P(b.strategy.max_drawdown)}</span><span class="c">benchmark {P(b.benchmark.max_drawdown)}</span></div>
          <div class="card kpi"><span class="k"><Term id="in-sample-and-out-of-sample">Out-of-sample</Term> CAGR</span><span class="v num">{P(b.out_of_sample?.strategy?.cagr)}</span><span class="c">benchmark {P(b.out_of_sample?.benchmark?.cagr)}</span></div>
          <div class="card kpi"><span class="k">Fees paid</span><span class="v num">€{N(b.strategy.fees_eur, 0)}</span><span class="c">{b.strategy.trades} trades over {b.strategy.years} years</span></div>
        </div>

        <div class="card pad chart">
          <LineChart id={`bt-${b.version}`} points={b.equity_curve} labels={[`${b.version}`, "MSCI World"]} log height={380} />
          <p class="caption">Growth of €1,000, log scale. Same-day close execution, fees and spreads included.</p>
        </div>

        <div class="grid split">
          <div class="card table-wrap metrics">
            <table class="data">
              <thead><tr><th></th><th class="r">Strategy</th><th class="r">Benchmark</th><th class="r">Strategy OOS</th><th class="r">Bench. OOS</th></tr></thead>
              <tbody>
                {rows.map(([k, label, f]) => (
                  <tr>
                    <td class="lbl">{termFor[k] ? <Term id={termFor[k]}>{label}</Term> : label}</td>
                    <td class="r num">{f(b.strategy?.[k])}</td>
                    <td class="r num muted">{f(b.benchmark?.[k])}</td>
                    <td class="r num">{OOS_NA.has(k) ? "—" : f(b.out_of_sample?.strategy?.[k])}</td>
                    <td class="r num muted">{OOS_NA.has(k) ? "—" : f(b.out_of_sample?.benchmark?.[k])}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {b.yearly && <div class="card pad"><p class="eyebrow">Calendar years</p><YearBars yearly={b.yearly} /></div>}
        </div>

        <p class="fine">
          Frictions: €{b.frictions.fee_eur} per order, spreads {(b.frictions.spread.etf * 100).toFixed(2)}% ETF and {(b.frictions.spread.stock * 100).toFixed(2)}% stock, crypto surcharge {(b.frictions.crypto_surcharge * 100).toFixed(2)}%, {b.frictions.execution}.
          <Term id="in-sample-and-out-of-sample">Out-of-sample</Term> means the last 30% of the period, and the parameters were not fitted to it.
          Mind <Term id="survivorship-bias">survivorship bias</Term>: the universe was chosen today.
          Data: {b.data.source}, {b.data.instruments} instruments.
        </p>
      </section>
    ))}

    <section class="block details">
      <div class="block-head"><h2>All the details</h2><p>The full write-up, as it is in <a href={blob("STRATEGY.md")}>STRATEGY.md</a></p></div>
      <div class="details-grid">
        <aside class="toc">
          <p class="eyebrow">Sections</p>
          <ol>{S.sections.map((x: any) => <li><a href={`#${x.slug}`}>{x.title}</a></li>)}</ol>
        </aside>
        <article class="card pad prose wide doc" set:html={S.html} />
      </div>
    </section>
  </div>
</Base>
<style>
  .bt .grid.stats { margin-bottom: 16px; }
  .lbl { white-space: nowrap; }
  .intro h2 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: 14px; }
  .summary { font-size: clamp(1.05rem, 1.7vw, 1.2rem); color: var(--fg-soft); max-width: 70ch; margin: 0; line-height: 1.6; }
  .files { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .files a { font-size: .82rem; font-weight: 500; color: var(--fg-soft); text-decoration: none; padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--bg-elev); }
  .files a::after { content: " ↗"; color: var(--muted); }
  .files a:hover { color: var(--fg); border-color: var(--fg-soft); }
  .decisions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .decision { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 6px; }
  .decision .n { font-size: .75rem; color: var(--accent); letter-spacing: .06em; }
  .decision .t { margin: 0; font-size: .74rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .decision .f { margin: 2px 0 4px; font-family: var(--font-serif); font-size: 1.45rem; line-height: 1.2; color: var(--fg); }
  .decision .x { margin: 0; font-size: .92rem; color: var(--fg-soft); line-height: 1.55; }
  .details-grid { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; align-items: start; }
  .toc { position: sticky; top: 88px; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .toc a { display: block; padding: 6px 10px; border-radius: 8px; font-size: .86rem; color: var(--fg-soft); text-decoration: none; line-height: 1.35; }
  .toc a:hover { background: var(--bg-sunk); color: var(--fg); }
  @media (max-width: 900px) { .details-grid { grid-template-columns: 1fr; } .toc { display: none; } }
  .split { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; }
  .metrics :global(th), .metrics :global(td) { padding-inline: 12px; }
  .metrics :global(th:first-child), .metrics :global(td:first-child) { padding-left: 20px; }
  .metrics :global(th:last-child), .metrics :global(td:last-child) { padding-right: 20px; }
  @media (max-width: 1100px) { .split { grid-template-columns: 1fr; } }
  .kpi { padding: 18px 20px; display: grid; gap: 4px; }
  .kpi .k { font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .kpi .v { font-size: 1.7rem; letter-spacing: -.02em; }
  .kpi .c { font-size: .82rem; color: var(--muted); }
  .chart { margin-bottom: 16px; }
  .caption { margin: 10px 0 0; font-size: .82rem; color: var(--muted); }
  .fine { font-size: .82rem; color: var(--muted); max-width: 90ch; margin-top: 16px; }
  .doc { padding: clamp(24px, 4vw, 48px); }
</style>
