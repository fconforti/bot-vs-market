---
// Calendar-year returns, strategy vs benchmark, as paired horizontal bars (pure CSS).
interface Props { yearly: { strategy: Record<string, number>; benchmark: Record<string, number> } }
const { yearly } = Astro.props;
const years = Object.keys(yearly.strategy).sort().reverse();
const max = Math.max(...years.flatMap((y) => [Math.abs(yearly.strategy[y] ?? 0), Math.abs(yearly.benchmark[y] ?? 0)]), 0.01);
const w = (v: number) => `${(Math.abs(v) / max) * 50}%`;
const p = (v: number) => `${v > 0 ? "+" : ""}${(v * 100).toFixed(1)}%`;
---
<div class="years">
  <div class="legend"><span class="sw s"></span>Strategy <span class="sw b"></span>Benchmark</div>
  {years.map((y) => {
    const s = yearly.strategy[y], b = yearly.benchmark[y];
    return (
      <div class="row">
        <span class="yr num">{y}</span>
        <div class="track">
          <span class={`bar s ${s < 0 ? "neg" : ""}`} style={`width:${w(s)}`}></span>
          <span class={`bar b ${b < 0 ? "neg" : ""}`} style={`width:${w(b)}`}></span>
        </div>
        <span class={`val num ${s >= b ? "pos" : "neg"}`} title="Strategy, then benchmark">{p(s)} <span class="muted">/ {p(b)}</span></span>
      </div>
    );
  })}
</div>
<style>
  .years { display: grid; gap: 7px; }
  .legend { display: flex; align-items: center; gap: 8px; font-size: .8rem; color: var(--muted); margin-bottom: 6px; }
  .sw { width: 12px; height: 8px; border-radius: 2px; display: inline-block; margin-left: 8px; }
  .sw.s { background: var(--accent); } .sw.b { background: var(--bench); }
  .row { display: grid; grid-template-columns: 44px 1fr 140px; align-items: center; gap: 12px; font-size: .82rem; }
  .yr { color: var(--muted); }
  .track { position: relative; height: 18px; background: linear-gradient(var(--line-strong), var(--line-strong)) center / 1px 100% no-repeat; }
  .bar { position: absolute; left: 50%; height: 7px; border-radius: 0 3px 3px 0; }
  .bar.s { top: 1px; background: var(--accent); }
  .bar.b { bottom: 1px; background: var(--bench); }
  .bar.neg { left: auto; right: 50%; border-radius: 3px 0 0 3px; }
  .val { text-align: right; white-space: nowrap; }
  @media (max-width: 520px) { .row { grid-template-columns: 38px 1fr 92px; } .val .muted { display: none; } }
</style>
