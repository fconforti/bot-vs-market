---
// Hero visual: portfolio (the bot) vs the benchmark (the market), drawn from real data.
// Live curve once there are at least two live snapshots; until then the latest backtest,
// labelled as such. Paths are computed at build time; each session rebuilds the site,
// so the curves follow the data day by day. Animation: both lines rise from below and
// draw left to right, the market first. Static for prefers-reduced-motion.
import { site } from "../lib/site";

const short = (d: string) => new Date(d + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

interface Pt { date: string; nav: number | null; benchmark: number | null }
const live: Pt[] = (site.curve || []).filter((p: Pt) => p.nav != null && p.benchmark != null);
const bt = site.strategy.backtests.at(-1);
const isLive = live.length >= 2;
const raw: Pt[] = isLive ? live : (bt?.equity_curve || []).filter((p: Pt) => p.nav != null && p.benchmark != null);

const W = 560, H = 360, L = 24, R = 120, T = 40, B = 40;
const MAX_POINTS = 90;
const step = Math.max(1, Math.ceil(raw.length / MAX_POINTS));
const pts = raw.filter((_, i) => i % step === 0 || i === raw.length - 1);

// Log scale when values span a lot (a 13-year backtest); linear for a short live run.
const all = pts.flatMap((p) => [p.nav!, p.benchmark!]);
const lo = Math.min(...all), hi = Math.max(...all);
const useLog = hi / lo > 2;
const f = (v: number) => (useLog ? Math.log(v) : v);
const pad = (f(hi) - f(lo)) * 0.06 || 1;
const y0 = f(lo) - pad, y1 = f(hi) + pad;
const X = (i: number) => L + (pts.length > 1 ? (i / (pts.length - 1)) * (W - L - R) : 0);
const Y = (v: number) => T + (1 - (f(v) - y0) / (y1 - y0)) * (H - T - B);
const path = (key: "nav" | "benchmark") => pts.map((p, i) => `${i ? "L" : "M"}${X(i).toFixed(1)} ${Y(p[key]!).toFixed(1)}`).join(" ");

const ok = pts.length >= 2;
const last = pts.at(-1)!, first = pts[0];
// Live: from the curve itself. Backtest: the reported totals (the stored curve is sampled).
const ret = (k: "nav" | "benchmark") => {
  if (!ok) return 0;
  if (!isLive && bt) {
    const r = k === "nav" ? bt.strategy?.total_return : bt.benchmark?.total_return;
    if (r != null) return r;
  }
  return last[k]! / first[k]! - 1;
};
const pct = (v: number) => `${v >= 0 ? "+" : ""}${(v * 100).toFixed(Math.abs(v) >= 1 ? 0 : 1)}%`;
const botY = ok ? Y(last.nav!) : 0, mktY = ok ? Y(last.benchmark!) : 0;
// Keep the end labels apart when the lines finish close together.
let botLY = botY, mktLY = mktY;
if (Math.abs(botY - mktY) < 34) {
  const mid = (botY + mktY) / 2, up = botY <= mktY;
  botLY = mid + (up ? -17 : 17); mktLY = mid + (up ? 17 : -17);
}
const endX = X(pts.length - 1);
const grid = [0, 1, 2, 3].map((k) => T + (k / 3) * (H - T - B));
const caption = isLive
  ? `Live: portfolio vs €${site.initial_eur.toLocaleString("en-IE")} in the MSCI World. Since ${short(first.date)}, updated ${short(last.date)}`
  : bt ? `Backtest, not live yet: ${bt.version} vs MSCI World, ${first.date.slice(0, 4)} to ${last.date.slice(0, 4)}, fees included` : "";
---
{ok && (
<figure class="hero-chart">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`${caption}. Bot ${pct(ret("nav"))}, market ${pct(ret("benchmark"))}.`}>
    <defs>
      <linearGradient id="hc-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--accent)" stop-opacity=".16" />
        <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g class="grid">{grid.map((y) => <line x1={L} x2={W - 24} y1={y} y2={y} />)}</g>
    <g class="line market">
      <path class="stroke" pathLength="1" d={path("benchmark")} />
      <circle class="dot" cx={endX} cy={mktY} r="5" />
      <text class="label" x={endX + 14} y={mktLY + 5}>Market <tspan class="val">{pct(ret("benchmark"))}</tspan></text>
    </g>
    <g class="line bot">
      <path class="area" d={`${path("nav")} L${endX.toFixed(1)} ${H - B} L${L} ${H - B} Z`} />
      <path class="stroke" pathLength="1" d={path("nav")} />
      <circle class="dot" cx={endX} cy={botY} r="5.5" />
      <text class="label" x={endX + 14} y={botLY + 5}>Bot <tspan class="val">{pct(ret("nav"))}</tspan></text>
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
)}

<style>
  .hero-chart { margin: 0; width: 100%; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  figcaption { margin-top: 6px; padding-left: 4%; font-size: .78rem; color: var(--muted); }
  .grid line { stroke: var(--line); stroke-width: 1; }
  .stroke { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .market .stroke { stroke: var(--bench); stroke-width: 3; opacity: .8; }
  .bot .stroke { stroke: var(--accent); stroke-width: 3.6; }
  .area { fill: url(#hc-fade); }
  .market .dot { fill: var(--bench); }
  .bot .dot { fill: var(--accent); }
  .label { font-family: var(--font-serif); font-size: 19px; font-weight: 600; fill: var(--fg); }
  .market .label { fill: var(--muted); font-weight: 500; }
  .val { font-family: var(--font-mono); font-size: 15px; font-weight: 500; }
  .bot .val { fill: var(--accent); }

  @media (prefers-reduced-motion: no-preference) {
    .line { animation: rise 1.6s cubic-bezier(.2, .8, .2, 1) both; }
    .stroke { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s cubic-bezier(.45, .05, .25, 1) both; }
    .area { animation: fade .8s ease-out both; }
    .dot, .label { animation: pop .5s cubic-bezier(.2, .9, .3, 1.4) both; transform-box: fill-box; transform-origin: center; }
    .market, .market .stroke { animation-delay: .15s; }
    .market .dot, .market .label { animation-delay: 1.55s; }
    .bot, .bot .stroke { animation-delay: .55s; animation-duration: 1.9s; }
    .bot .area { animation-delay: 2.3s; }
    .bot .dot, .bot .label { animation-delay: 2.3s; }
    @keyframes rise { from { transform: translateY(70px); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes pop { from { opacity: 0; transform: scale(.4); } to { opacity: 1; transform: none; } }
  }
</style>
