---
interface Props { title: string }
const { title } = Astro.props;
---
<div class="card empty">
  <svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true" style="margin-bottom:12px;opacity:.6"><rect x="4" y="10" width="40" height="30" rx="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M11 32l8-8 6 5 12-12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="3 4"/></svg>
  <strong>{title}</strong>
  <p><slot /></p>
</div>
